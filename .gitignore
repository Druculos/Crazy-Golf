# Godot 4+ specific ignores
.godot/
/android/

# macOS Finder files
.DS_Store

# Blender auto-backups
*.blend1

# Web build (re-export from Godot instead of committing it)
/web_export/

# Web builds exported into the project root, and project zips (keep them out of git)
/Bounce Game*
/Crazy golf*
/Archive.zip

# Store preview videos (large; regenerate with the --promo mode)
/store_assets/**/*.mp4
